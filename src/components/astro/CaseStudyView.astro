---
import type { StandaloneCaseStudy, StandaloneListItem } from "../../data/standaloneCaseStudies";
import { appProjects, getProjectLinksBySlug } from "../../data/projects";
import CaseStudyRelatedLinks from "./CaseStudyRelatedLinks.astro";
import CaseStudyFlow from "./CaseStudyFlow.astro";
import CaseStudyBillingDemo from "./CaseStudyBillingDemo.astro";

interface Props {
  study: StandaloneCaseStudy;
}

const { study } = Astro.props as Props;
const relatedLinks = getProjectLinksBySlug(study.slug);
const appStudySlugs = appProjects.map((project) => project.slug);
const currentAppStudyIndex = appStudySlugs.indexOf(study.slug);
const prevAppStudySlug = currentAppStudyIndex > 0 ? appStudySlugs[currentAppStudyIndex - 1] : null;
const nextAppStudySlug =
  currentAppStudyIndex >= 0 && currentAppStudyIndex < appStudySlugs.length - 1
    ? appStudySlugs[currentAppStudyIndex + 1]
    : null;
const prevAppStudy = prevAppStudySlug ? appProjects.find((project) => project.slug === prevAppStudySlug) : null;
const nextAppStudy = nextAppStudySlug ? appProjects.find((project) => project.slug === nextAppStudySlug) : null;

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");

const renderInlineMarkdown = (value: string) => {
  const markdownLinkPattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g;

  return escapeHtml(value).replace(markdownLinkPattern, (_match, label, href) => {
    const safeLabel = escapeHtml(label);
    const safeHref = escapeHtml(href);

    return `<a href="${safeHref}" target="_blank" rel="noopener noreferrer" class="text-text-primary underline decoration-border underline-offset-4 transition-colors duration-200 hover:text-accent">${safeLabel}</a>`;
  });
};
---

  <header class="section-reveal mt-8 sm:mt-12 mb-12 sm:mb-16">
    <h1 class="min-title mb-3">
      {study.title}
    </h1>
    <p class="min-subtitle mb-6">
      {study.tagline}
    </p>
    <div class="min-meta flex flex-wrap gap-6">
      {study.meta.map((meta) => (
        <span>{meta.value}</span>
      ))}
    </div>
  </header>

{study.media ? (
    <figure class="case-study-media section-reveal">
      <img
        src={study.media.src}
        alt={study.media.alt}
        class:list={["block max-w-full h-auto bg-bg-surface", study.media.className]}
        loading="lazy"
      />
    </figure>
) : null}

{study.sections.map((section, sectionIndex) => (
    <section class:list={[
      "mt-16 sm:mt-20",
      !section.blocks.some((block) => block.type === "gallery" && block.images.some((image) => image.callouts?.length)) && "section-reveal",
      sectionIndex === study.sections.length - 1 && "mb-16",
    ]}>
      <h3 class="case-study-section-title mb-6">{section.title}</h3>

      {section.blocks.map((block) => (
        <>
          {block.type === "paragraphs" ? (
            block.paragraphs.map((paragraph, paragraphIndex) => (
              <p class:list={["min-body", paragraphIndex < block.paragraphs.length - 1 ? "mb-5" : ""]}>
                {paragraph}
              </p>
            ))
          ) : null}

          {block.type === "quote" ? (
            <blockquote class="min-body border-l-3 border-accent bg-accent-soft px-7 py-5 my-10 italic">
              {block.text}
            </blockquote>
          ) : null}

          {block.type === "bullets" ? (
            <ul class="space-y-2.5 mt-4">
              {block.items.map((item, itemIndex) => (
                <li class="min-body flex gap-3">
                  {block.ordered ? (
                    <span class="min-small mt-0.5">{String(itemIndex + 1).padStart(2, "0")}</span>
                  ) : (
                    <span class="text-accent/50 flex-shrink-0">—</span>
                  )}
                    <span>
                      {typeof item === "string" ? (
                      <Fragment set:html={renderInlineMarkdown(item)} />
                      ) : (
                      <>
                        {item.title ? <strong class="text-text-primary" style="font-weight: 600;">{item.title}</strong> : null}
                        {item.title ? " — " : ""}
                        {item.text}
                      </>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          ) : null}

          {block.type === "chips" ? (
            <div class="space-y-3 mt-4">
              {block.rows.map((row) => (
                <div class="min-small flex flex-wrap items-center gap-2.5">
                  {row.map((chip, chipIndex) => (
                    <>
                      <span class="border border-border px-3 py-1 bg-transparent italic">{chip}</span>
                      {chipIndex < row.length - 1 ? <span class="text-accent/40">&rarr;</span> : null}
                    </>
                  ))}
                </div>
              ))}
            </div>
          ) : null}

          {block.type === "flow" ? <CaseStudyFlow diagram={block.diagram} /> : null}
          {block.type === "billing-demo" ? <CaseStudyBillingDemo scenarios={block.scenarios} /> : null}

          {block.type === "subsections" ? (
            <>
              {block.items.map((item) => (
                <div class="mt-10 first:mt-0">
                  <h4 class="case-study-subsection-title mb-3">{item.title}</h4>
                  {item.paragraphs?.map((paragraph, paragraphIndex) => (
                    <p class:list={["min-body", paragraphIndex < (item.paragraphs?.length ?? 0) - 1 ? "mb-5" : ""]}>
                      {paragraph}
                    </p>
                  ))}
                  {item.chips ? (
                    <div class="min-small flex flex-wrap items-center gap-2.5">
                      {item.chips.map((chip, chipIndex) => (
                        <>
                          <span class="border border-border px-3 py-1 bg-transparent italic">{chip}</span>
                          {chipIndex < item.chips.length - 1 ? <span class="text-accent/40">&rarr;</span> : null}
                        </>
                      ))}
                    </div>
                  ) : null}
                  {item.bullets ? (
                    <ul class="space-y-2.5 mt-4">
                      {item.bullets.map((bullet, bulletIndex) => (
                        <li class="min-body flex gap-3">
                          {item.ordered ? (
                            <span class="min-small mt-0.5">{String(bulletIndex + 1).padStart(2, "0")}</span>
                          ) : (
                            <span class="text-accent/50 flex-shrink-0">—</span>
                          )}
                          <span>
                            {typeof bullet === "string" ? (
                              <Fragment set:html={renderInlineMarkdown(bullet)} />
                            ) : (
                              <>
                                {bullet.title ? <strong class="text-text-primary font-display">{bullet.title}</strong> : null}
                                {bullet.title ? " — " : ""}
                                {bullet.text}
                              </>
                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  ) : null}
                </div>
              ))}
            </>
          ) : null}

          {block.type === "cards" ? (
            <div class="space-y-4">
              {block.items.map((card) => (
                <a
                  href={card.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block py-2 min-link"
                >
                  {card.title} — {card.description}
                </a>
              ))}
            </div>
          ) : null}

          {block.type === "figure" ? (
            <figure class:list={["case-study-media mt-8", block.image.figureClass]}>
              <img
                src={block.image.src}
                alt={block.image.alt}
                loading="lazy"
                class:list={["block max-w-full h-auto", block.image.imageClass]}
              />
            </figure>
          ) : null}

          {block.type === "gallery" ? (
            <div class:list={["case-study-gallery", block.paired && "case-study-gallery--paired"]}>
              {block.images.map((image) => (
                <figure class:list={["case-study-media case-study-gallery-item", image.cardClass]}>
                  <div class="relative">
                    <img
                      src={image.src}
                      alt={`${image.title}. ${image.description}`}
                      loading="lazy"
                      class="case-study-gallery-image"
                    />
                    {image.callouts?.map(({ area: [left, top, width, height] }, index) => (
                      <div
                        class="screenshot-callout"
                        style={{ left: `${left}%`, top: `${top}%`, width: `${width}%`, height: `${height}%` }}
                        aria-hidden="true"
                      >
                        <span class="callout-number">{index + 1}</span>
                      </div>
                    ))}
                  </div>
                  {image.showCaption || image.callouts?.length ? (
                    <figcaption class="case-study-image-caption">
                      {image.showCaption && (
                        <>
                          <strong>{image.title}</strong>
                          <span>{image.description}</span>
                        </>
                      )}
                      {image.callouts?.length ? (
                        <ol class="callout-key" role="list">
                          {image.callouts.map((callout, index) => (
                            <li>
                              <span class="callout-number" aria-hidden="true">{index + 1}</span>
                              <p><strong>{callout.block}.</strong> {callout.detail}</p>
                            </li>
                          ))}
                        </ol>
                      ) : null}
                    </figcaption>
                  ) : null}
                </figure>
              ))}
            </div>
          ) : null}

          {block.type === "spotlights" ? (
            <div class="mt-10 sm:mt-14 md:mt-16 space-y-12 sm:space-y-16 md:space-y-20">
              {block.items.map((item) => (
                <div class:list={[
                  "grid grid-cols-1 md:grid-cols-[minmax(0,320px)_minmax(0,1fr)] gap-8 md:gap-12 items-start",
                  item.imagePosition === "right" && "md:grid-cols-[minmax(0,1fr)_minmax(0,320px)]",
                ]}>
                  <div class:list={[item.imagePosition === "right" && "md:order-2"]}>
                    <figure>
                      <img
                        src={item.image.src}
                        alt={item.image.alt}
                        loading="lazy"
                        class:list={["w-full", item.image.className]}
                      />
                    </figure>
                  </div>

                  <div class:list={["space-y-4", item.imagePosition === "right" && "md:order-1"]}>
                    {item.eyebrow ? (
                      <p class="min-small">{item.eyebrow}</p>
                    ) : null}
                    <h4 class="case-study-section-title">{item.title}</h4>
                    {item.paragraphs.map((paragraph) => (
                      <p class="min-body">{paragraph}</p>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ) : null}
        </>
      ))}
    </section>
))}

<CaseStudyRelatedLinks links={relatedLinks} />

{study.backHref === "/#apps" && (prevAppStudy || nextAppStudy) ? (
  <nav class="flex items-stretch justify-between gap-4 border-t border-border pt-8 mb-16">
    {prevAppStudy ? (
      <a href={`/work/${prevAppStudy.slug}`} class="group flex flex-col items-start gap-1 max-w-[45%]">
        <span class="min-small group-hover:text-text-primary transition-colors duration-200">&larr; Previous</span>
        <span class="min-meta group-hover:text-text-primary transition-colors duration-200">{prevAppStudy.title}</span>
      </a>
    ) : <div />}
    {nextAppStudy ? (
      <a href={`/work/${nextAppStudy.slug}`} class="group flex flex-col items-end gap-1 max-w-[45%] text-right ml-auto">
        <span class="min-small group-hover:text-text-primary transition-colors duration-200">Next &rarr;</span>
        <span class="min-meta group-hover:text-text-primary transition-colors duration-200">{nextAppStudy.title}</span>
      </a>
    ) : <div />}
  </nav>
) : null}

<style>
  @media (min-width: 640px) {
    .case-study-gallery--paired {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-study-gallery--paired > .case-study-gallery-item {
      grid-column: auto;
    }
  }

  .screenshot-callout {
    position: absolute;
    pointer-events: none;
    border: 1.5px solid #222;
    border-radius: 3px;
    box-shadow: 0 0 0 1px #fff;
  }

  .callout-number {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    font: 600 0.75rem / 1 var(--font-display);
  }

  .screenshot-callout .callout-number {
    position: absolute;
    top: 0;
    right: 0;
    transform: translateY(-50%);
    color: #fff;
    background: #222;
    box-shadow: 0 0 0 1px #fff;
  }

  .callout-key {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .callout-key li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.5rem;
    line-height: 1.4;
  }

  .callout-key .callout-number {
    color: var(--color-bg-deep);
    background: var(--color-text-primary);
  }
</style>
