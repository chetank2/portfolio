---
import type { StandaloneFlowDiagram } from "../../data/standaloneCaseStudies";
import CaseStudyFlowSketch from "./CaseStudyFlowSketch.astro";

interface Props {
  diagram: StandaloneFlowDiagram;
}

const { diagram } = Astro.props;
---

<figure class="flow">
  <figcaption class="case-study-subsection-title">{diagram.title}</figcaption>
  {diagram.paths.map((path) => (
    <div class="flow-path">
      {path.label && <p class="flow-label">{path.label}</p>}
      <ol class="flow-steps" role="list" aria-label={path.label}>
        {path.steps.map((step, index) => (
          <li class="flow-step">
            <span class="flow-art"><CaseStudyFlowSketch sketch={step.sketch} /></span>
            <div class="flow-copy">
              {step.label && <span class="flow-label">{step.label}</span>}
              <strong>{step.title}</strong>
              {step.detail && <span class="flow-detail">{step.detail}</span>}
            </div>
            {index < path.steps.length - 1 && (
              <svg class="flow-arrow" viewBox="0 0 30 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M2 11c7-5 16-6 25-3m-6-5 7 5-8 4" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </div>
  ))}
  {diagram.note && <p class="flow-note">{diagram.note}</p>}
</figure>

<style>
  .flow {
    container-type: inline-size;
    margin-block: 2rem;
    padding-block: 1rem 1.25rem;
    border-block: 1px solid var(--color-border);
  }

  .flow figcaption {
    padding-bottom: 0.25rem;
  }

  .flow-path {
    margin-top: 1rem;
  }

  .flow-path + .flow-path {
    border-top: 1px dashed var(--color-border);
    padding-top: 1rem;
  }

  .flow-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-text-secondary);
    font: 0.75rem / 1.35 var(--font-display);
  }

  .flow-steps {
    display: grid;
    gap: 1.25rem;
    list-style: none;
  }

  .flow-step {
    position: relative;
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    font: 1.05rem / 1.28 var(--font-body);
  }

  .flow-art {
    display: grid;
    place-items: center;
  }

  .flow-art :global(svg) {
    display: block;
    width: 100%;
    max-width: 6rem;
    height: auto;
  }

  .flow-arrow {
    position: absolute;
    bottom: -1.125rem;
    left: 1.65rem;
    width: 1.45rem;
    height: auto;
    color: var(--color-text-secondary);
    transform: rotate(90deg);
  }

  .flow-detail,
  .flow-note {
    color: var(--color-text-secondary);
    font: 0.95rem / 1.35 var(--font-body);
  }

  .flow-detail {
    display: block;
    margin-top: 0.25rem;
    white-space: pre-line;
  }

  .flow-note {
    margin-top: 1.25rem;
    font-style: italic;
  }

  @container (min-width: 30rem) {
    .flow-steps {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 1.875rem;
    }

    .flow-step {
      display: block;
      text-align: center;
    }

    .flow-art {
      margin-bottom: 0.35rem;
    }

    .flow-copy .flow-label {
      min-height: 2.7em;
    }

    .flow-arrow {
      top: 1.625rem;
      bottom: auto;
      left: calc(100% + 0.125rem);
      width: 1.625rem;
      transform: none;
    }
  }
</style>
