---
import type { ProjectLink } from "../../data/projects";

interface Props {
  links: ProjectLink[];
}

const { links } = Astro.props as Props;
---

{links.length ? (
  <section class="mt-16 mb-16">
    <h3 class="min-subsection-title mb-4">Related Links</h3>
    {links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="block py-2 min-link"
      >
        {link.title} — {link.description}
      </a>
    ))}
  </section>
) : null}
