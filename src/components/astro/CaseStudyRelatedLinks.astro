---
import type { ProjectLink } from "../../data/projects";

interface Props {
  links: ProjectLink[];
}

const { links } = Astro.props as Props;
---

{links.length ? (
  <section class="mt-16 mb-16">
    <h3 style="font-family: var(--font-body); font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem; color: var(--color-text-primary);">Related Links</h3>
    {links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="block py-2 text-text-secondary hover:text-text-primary transition-colors duration-200"
        style="font-family: var(--font-body); font-size: 1rem; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-border);"
      >
        {link.title} — {link.description}
      </a>
    ))}
  </section>
) : null}
