---
interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

const footerLinks = [
  { label: "Design", href: "/design.md", external: false },
  { label: "Resume", href: "https://drive.google.com/file/d/1z_3M7pbPU2_SPSs7yqoKNkId2hXFGUCq/view?usp=sharing", external: true },
  { label: "X", href: "https://x.com/kchetank19", external: true },
  { label: "LinkedIn", href: "https://linkedin.com/in/chetan-kumar25/", external: true },
  { label: "GitHub", href: "https://github.com/chetank2", external: true },
];
---

<footer>
  <div class:list={[
    "pt-8 pb-12 sm:pt-10 sm:pb-16",
    minimal
      ? "editorial-container"
      : "mx-auto max-w-[1200px] 2xl:max-w-[1600px] px-5 sm:px-6 md:px-12 2xl:px-24",
  ]}>
    {minimal && <hr class="mb-8" style="border: none; height: 1px; background: var(--color-text-primary); opacity: 0.15;" />}
    <div class="footer-clean">
      <p class="min-small">&copy; 2026 Chetan Kummari</p>
      <nav class="footer-link-row" aria-label="Footer">
        {footerLinks.map((link) => (
          <a
            href={link.href}
            class="min-small transition-colors duration-200 hover:text-text-primary"
            style="text-decoration: none;"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
