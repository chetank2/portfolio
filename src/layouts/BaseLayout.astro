---
import "../styles/global.css";
import { portfolioMachineLinks } from "../data/projects";

interface Props {
  title?: string;
  description?: string;
  machineMode?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const defaultDescription =
  "Senior Product Designer at Generalmind, specializing in AI-native enterprise workflows, complex B2B systems, design systems, and building products with AI.";

const {
  title = "Chetan Kummari — Product Designer",
  description = defaultDescription,
  machineMode = false,
  structuredData = [],
} = Astro.props;

// Compute machine-readable alternate URL for case study pages
const pathname = Astro.url.pathname.replace(/\/$/, "");
const isCaseStudy = pathname.startsWith("/work/") && pathname !== "/work";
const siteHref = portfolioMachineLinks.siteHref.replace(/\/$/, "");
const canonicalPath = pathname === "" ? "/" : pathname;
const canonicalHref = `${siteHref}${canonicalPath === "/" ? "" : canonicalPath}`;
const machineAlternateHref = isCaseStudy ? `${siteHref}/machine${pathname}` : null;
const llmsHref = `${siteHref}/llms.txt`;
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteHref}/#person`,
    name: "Chetan Kummari",
    url: siteHref,
    jobTitle: "Senior Product Designer",
    worksFor: {
      "@type": "Organization",
      name: "Generalmind",
    },
    knowsAbout: [
      "AI-native design workflows",
      "Product design",
      "Design systems",
      "Enterprise UX",
      "B2B SaaS",
      "Logistics operations",
      "Design QA",
      "Generative Engine Optimization",
    ],
    sameAs: [
      portfolioMachineLinks.linkedInHref,
      portfolioMachineLinks.xHref,
      "https://github.com/chetank2",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteHref}/#website`,
    name: "Chetan Kummari Portfolio",
    url: siteHref,
    inLanguage: "en",
    author: {
      "@id": `${siteHref}/#person`,
    },
    description: defaultDescription,
  },
];
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const inferredPageStructuredData =
  pageStructuredData.length > 0
    ? pageStructuredData
    : isCaseStudy
      ? [
          {
            "@context": "https://schema.org",
            "@type": "CreativeWork",
            "@id": `${canonicalHref}#case-study`,
            name: title.replace(" — Chetan Kummari", ""),
            description,
            url: canonicalHref,
            isPartOf: {
              "@id": `${siteHref}/#website`,
            },
            author: {
              "@id": `${siteHref}/#person`,
            },
          },
        ]
      : [];
const structuredDataJson = JSON.stringify([...baseStructuredData, ...inferredPageStructuredData]);
---

<!doctype html>
<html lang="en" class:list={["theme-light", machineMode && "machine-mode"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Chetan Kummari" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="generator" content="Astro" />
    <link rel="canonical" href={canonicalHref} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="Chetan Kummari Portfolio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts: EB Garamond (serif body), Libre Baskerville (serif display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    {machineAlternateHref && (
      <link rel="alternate" type="text/plain" href={machineAlternateHref} title="Machine-readable version" />
    )}

    <!-- llms.txt — AI/LLM agent discovery (https://llmstxt.org) -->
    <link rel="alternate" type="text/plain" href={llmsHref} title="llms.txt — AI agent briefing" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={structuredDataJson} />
    <script is:inline>
      (() => {
        const storageKey = "portfolio-theme";
        const root = document.documentElement;

        const applyTheme = (theme) => {
          const nextTheme = theme === "dark" ? "dark" : "light";
          root.classList.toggle("theme-dark", nextTheme === "dark");
          root.classList.toggle("theme-light", nextTheme === "light");
          root.dataset.theme = nextTheme;
          window.dispatchEvent(
            new CustomEvent("portfolio-themechange", {
              detail: { theme: nextTheme },
            }),
          );
        };

        const getTheme = () => {
          try {
            const storedTheme = window.localStorage.getItem(storageKey);
            return storedTheme === "dark" ? "dark" : "light";
          } catch {
            return "light";
          }
        };

        window.__portfolioTheme = {
          getTheme: () => (root.classList.contains("theme-dark") ? "dark" : "light"),
          setTheme: (theme) => {
            const nextTheme = theme === "dark" ? "dark" : "light";
            try {
              window.localStorage.setItem(storageKey, nextTheme);
            } catch {}
            applyTheme(nextTheme);
          },
        };

        applyTheme(getTheme());
      })();
    </script>
    <script is:inline>
      (() => {
        const copyText = async (text) => {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
            return;
          }

          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          textarea.style.pointerEvents = "none";
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          document.body.removeChild(textarea);
        };

        document.addEventListener("click", async (event) => {
          const button = event.target instanceof Element
            ? event.target.closest("[data-machine-copy]")
            : null;
          if (!(button instanceof HTMLButtonElement)) return;

          const root = button.closest("[data-machine-shell]");
          const target = root?.querySelector("[data-machine-copy-target]");
          if (!(target instanceof HTMLElement)) return;

          const content = target.innerText.trim();
          if (!content) return;

          try {
            await copyText(content);
            button.dataset.copied = "true";
            window.setTimeout(() => {
              delete button.dataset.copied;
            }, 1200);
          } catch (_error) {
            button.dataset.copied = "false";
            window.setTimeout(() => {
              delete button.dataset.copied;
            }, 1200);
          }
        });
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class:list={[machineMode && "machine-mode"]}>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script is:inline>
      (() => {
        const updateStickyBackLinks = () => {
          const shouldShow = window.scrollY > 96;
          document.querySelectorAll(".case-study-sticky-back").forEach((link) => {
            if (!(link instanceof HTMLElement)) return;
            link.dataset.visible = shouldShow ? "true" : "false";
          });
        };

        window.addEventListener("scroll", updateStickyBackLinks, { passive: true });
        window.addEventListener("resize", updateStickyBackLinks);
        updateStickyBackLinks();
      })();
    </script>
    <script is:inline>
      (() => {
        const sections = Array.from(
          document.querySelectorAll(
            ".section-reveal, .case-study-content > h2, .case-study-content > h3, .case-study-content > h4, .case-study-content > p, .case-study-content > ul, .case-study-content > ol, .case-study-content > blockquote, .case-study-content > .case-study-link-list, .case-study-content > hr",
          ),
        );
        if (!sections.length) return;

        const reveal = (section) => {
          if (!(section instanceof HTMLElement)) return;
          section.dataset.sectionRevealed = "true";
        };

        sections.forEach((section) => {
          if (section instanceof HTMLElement) {
            section.dataset.sectionRevealReady = "true";
          }
        });

        if (!("IntersectionObserver" in window)) {
          sections.forEach(reveal);
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              reveal(entry.target);
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.16,
            rootMargin: "0px 0px -10% 0px",
          },
        );

        sections.forEach((section) => observer.observe(section));
      })();
    </script>
    <script is:inline>
      (() => {
        let lightbox;
        let lightboxImage;
        let previousBodyOverflow = "";

        const closeLightbox = () => {
          if (!lightbox || !lightboxImage) return;
          lightbox.dataset.open = "false";
          lightboxImage.removeAttribute("src");
          lightboxImage.removeAttribute("alt");
          document.body.style.overflow = previousBodyOverflow;
        };

        const ensureLightbox = () => {
          if (lightbox && lightboxImage) return;

          lightbox = document.createElement("div");
          lightbox.className = "case-study-image-lightbox";
          lightbox.dataset.open = "false";
          lightbox.setAttribute("role", "dialog");
          lightbox.setAttribute("aria-modal", "true");
          lightbox.setAttribute("aria-label", "Expanded case study image");

          lightboxImage = document.createElement("img");
          lightboxImage.className = "case-study-image-lightbox__image";

          const closeButton = document.createElement("button");
          closeButton.type = "button";
          closeButton.className = "case-study-image-lightbox__close";
          closeButton.setAttribute("aria-label", "Close expanded image");
          closeButton.innerHTML = `
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          `;

          lightbox.append(lightboxImage, closeButton);
          document.body.appendChild(lightbox);

          closeButton.addEventListener("click", closeLightbox);

          lightbox.addEventListener("click", (event) => {
            const target = event.target;
            if (
              target === lightbox ||
              target === lightboxImage ||
              (target instanceof Node && closeButton.contains(target))
            ) {
              closeLightbox();
            }
          });
        };

        document.addEventListener("click", (event) => {
          const image = event.target instanceof Element
            ? event.target.closest(".case-study-content img, .longform-content img")
            : null;
          if (!(image instanceof HTMLImageElement) || !image.currentSrc) return;

          ensureLightbox();
          previousBodyOverflow = document.body.style.overflow;
          lightboxImage.src = image.currentSrc;
          lightboxImage.alt = image.alt || "Expanded case study image";
          lightbox.dataset.open = "true";
          document.body.style.overflow = "hidden";
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeLightbox();
        });
      })();
    </script>
  </body>
</html>
