---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/astro/Navigation.astro";
import Footer from "../../components/astro/Footer.astro";
import ProtectedCaseStudy from "../../components/react/ProtectedCaseStudy.tsx";
import CaseStudyView from "../../components/astro/CaseStudyView.astro";
import MachinePageShell from "../../components/astro/MachinePageShell.astro";
import ViewModeToggle from "../../components/astro/ViewModeToggle.astro";
import {
  standaloneCaseStudies,
  standaloneCaseStudyMachineText,
} from "../../data/standaloneCaseStudies";
import { findProjectBySlug } from "../../data/projects";
import {
  SHARED_CASE_STUDY_PASSWORD,
  shouldRenderProtectedBody,
} from "../../lib/caseStudyProtection";

const study = standaloneCaseStudies["journey-redesign"];
const projectMeta = findProjectBySlug(study.slug);
const protectedTagline = projectMeta?.tagline ?? study.tagline;
const protectedSummary = projectMeta?.machineSummary;
const revealBody = shouldRenderProtectedBody(study.slug);
const machinePageText = revealBody
  ? standaloneCaseStudyMachineText[study.slug]
  : [
      `# ${study.title}`,
      `> ${protectedTagline}`,
      "",
      `- Status: Protected — full case study available on request`,
      ...(protectedSummary ? ["", "## Summary", protectedSummary] : []),
    ].join("\n");
---

<BaseLayout title={`${study.title} — Chetan Kummari`}>
  <div data-view-panel="human">
    <Navigation minimal />
  </div>
  <main id="main">
    <div data-view-panel="human" class="bg-bg-deep min-h-screen pt-20 sm:pt-28 pb-24 sm:pb-32 px-6 sm:px-8">
      <div class="max-w-[600px] mx-auto">
        <a href={study.backHref} class="back-link">Back</a>
        <ProtectedCaseStudy
          client:load
          password={SHARED_CASE_STUDY_PASSWORD}
          storageKey={`case-study:${study.slug}`}
          title={study.title}
          tagline={protectedTagline}
          summary={protectedSummary}
        >
          {revealBody && <CaseStudyView study={study} />}
        </ProtectedCaseStudy>
      </div>
    </div>
    <div data-view-panel="machine" hidden class="bg-bg-deep min-h-screen">
      <ProtectedCaseStudy
        client:load
        password={SHARED_CASE_STUDY_PASSWORD}
        storageKey={`case-study:${study.slug}`}
        title={study.title}
        tagline={protectedTagline}
        summary={protectedSummary}
      >
        <MachinePageShell title={study.title} pageHref={`/work/${study.slug}`} text={machinePageText} />
    </div>
  </main>
  <ViewModeToggle />
  <div data-view-panel="human">
    <Footer minimal />
  </div>
</BaseLayout>
