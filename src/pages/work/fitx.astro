---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/astro/Navigation.astro";
import Footer from "../../components/astro/Footer.astro";
import CaseStudyView from "../../components/astro/CaseStudyView.astro";
import MachinePageShell from "../../components/astro/MachinePageShell.astro";
import ViewModeToggle from "../../components/astro/ViewModeToggle.astro";
import { standaloneCaseStudies, standaloneCaseStudyMachineText } from "../../data/standaloneCaseStudies";

const study = standaloneCaseStudies["fitx"];
---

<BaseLayout title={`${study.title} — Chetan Kummari`}>
  <div data-view-panel="human">
    <Navigation minimal />
  </div>
  <main id="main">
    <div data-view-panel="human" class="bg-bg-deep min-h-screen pt-8 sm:pt-12 pb-16 sm:pb-20 px-5 sm:px-6">
      <div class="max-w-[600px] mx-auto">
        <a href={study.backHref} class="back-link">Back</a>
        <CaseStudyView study={study} />
      </div>
    </div>
    <div data-view-panel="machine" hidden class="bg-bg-deep min-h-screen">
      <MachinePageShell title={study.title} pageHref={`/work/${study.slug}`} text={standaloneCaseStudyMachineText[study.slug]} />
    </div>
  </main>
  <ViewModeToggle />
  <div data-view-panel="human">
    <Footer minimal />
  </div>
</BaseLayout>
