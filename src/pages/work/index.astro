---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/astro/Navigation.astro";
import Footer from "../../components/astro/Footer.astro";
import MachinePageShell from "../../components/astro/MachinePageShell.astro";
import ViewModeToggle from "../../components/astro/ViewModeToggle.astro";
import { supportingProjects, appProjects, websiteProjects } from "../../data/projects";

const workMachineText = [
  "# Work",
  "> Extended archive of systems work, app designs, and web projects.",
  "",
  "## Systems",
  ...supportingProjects.map((project) => `- ${project.title} — ${project.tagline} (${project.caseStudyUrl}, protected)`),
  "",
  "## App Designs",
  ...appProjects.map((project) => `- ${project.title} — ${project.tagline} (${project.caseStudyUrl})`),
  "",
  "## Web Projects",
  ...websiteProjects.map((project) => `- ${project.title} — ${project.tagline} (${project.liveUrl})`),
].join("\n");
---

<BaseLayout title="Work — Chetan Kummari">
  <div data-view-panel="human">
    <Navigation minimal />
  </div>

  <main id="main">
    <div data-view-panel="machine" hidden class="bg-bg-deep min-h-screen">
      <MachinePageShell title="Work" pageHref="/work" text={workMachineText} />
    </div>

    <div data-view-panel="human">
      <div class="minimal-page">
        <!-- Back link -->
        <a href="/" class="type-ui-meta inline-flex items-center gap-2 text-text-tertiary hover:text-accent transition-colors duration-300 mb-12">
          <span class="w-4 h-px bg-text-tertiary"></span>
          Back
        </a>

        <!-- Case Studies section -->
        <h2 class="min-subsection-title mb-4">Case Studies</h2>
        {supportingProjects.map((project) => (
          <a href={project.caseStudyUrl || "#"} class="project-link">
            {project.title} — {project.tagline}{project.protected ? " ↗" : ""}
          </a>
        ))}

        <!-- App Designs section -->
        <div class="section-gap">
          <h2 class="min-subsection-title mb-4">App Designs</h2>
          {appProjects.map((project) => (
            <a href={project.caseStudyUrl || "#"} class="project-link">
              {project.title} — {project.tagline}
            </a>
          ))}
        </div>

        <!-- Web Designs section -->
        <div class="section-gap">
          <h2 class="min-subsection-title mb-4">Web Projects</h2>
          {websiteProjects.map((project) => (
            <a href={project.liveUrl || "#"} class="project-link" target="_blank" rel="noopener noreferrer">
              {project.title} — {project.tagline}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>

  <ViewModeToggle />
  <div data-view-panel="human">
    <Footer minimal />
  </div>
</BaseLayout>
