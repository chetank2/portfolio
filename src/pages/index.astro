---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/astro/Navigation.astro";
import MachinePageShell from "../components/astro/MachinePageShell.astro";
import ViewModeToggle from "../components/astro/ViewModeToggle.astro";
import Footer from "../components/astro/Footer.astro";
import {
  deepProjects,
  aiProjects,
  experience,
  article,
} from "../data/projects";
import { CASE_STUDY_PASSWORD_LOCK_ENABLED } from "../lib/caseStudyProtection";

function formatProjectLine(project: (typeof deepProjects)[number] | (typeof aiProjects)[number]) {
  const href = project.caseStudyUrl ?? "#";
  if (CASE_STUDY_PASSWORD_LOCK_ENABLED && project.protected) {
    const summary = project.machineSummary ?? project.tagline;
    return `- ${project.title} (protected) — ${summary} (${href})`;
  }
  if (project.caseStudyUrl?.startsWith("/work/")) {
    return `- ${project.title} — ${project.tagline} (${project.caseStudyUrl}, /machine${project.caseStudyUrl})`;
  }
  return `- ${project.title} — ${project.tagline} (${href})`;
}

const homeMachineText = [
  "# Chetan Kummari",
  "> Senior Product Designer at Generalmind focused on AI-native enterprise workflows, complex B2B systems, design systems, and AI-assisted product building.",
  "",
  "## Work",
  ...deepProjects.map(formatProjectLine),
  "",
  "## Built with AI",
  ...aiProjects.map(formatProjectLine),
  "",
  "## Experience",
  ...experience.flatMap((exp) => [
    `### ${exp.role} — ${exp.company}`,
    `- Location: ${exp.location}`,
    `- Period: ${exp.period}`,
    ...exp.highlights.map((highlight) => `- ${highlight}`),
    "",
  ]),
  "## Writing",
  `- ${article.title} — ${article.summary} (${article.url})`,
  "",
  "## Contact",
  "- Resume: https://drive.google.com/file/d/1z_3M7pbPU2_SPSs7yqoKNkId2hXFGUCq/view?usp=sharing",
  "- Email: mailto:mymailchetan25@gmail.com",
  "- X: https://x.com/kchetank19",
  "- LinkedIn: https://linkedin.com/in/chetan-kumar25/",
  "- GitHub: https://github.com/chetank2",
].join("\n");

const designWork = [
  {
    name: "Freight Tiger TMS",
    tagline: "When tracking becomes the product, operations start to move right",
    href: "/work/ft-tms-redesign",
    protected: true,
  },
  {
    name: "Control Tower",
    tagline: "Seeing everything is not the same as controlling it, so we designed for action, not visibility",
    href: "/work/control-tower",
    protected: true,
  },
  {
    name: "FT Design System",
    tagline: "Design infrastructure for humans, engineers, and AI agents",
    href: "/work/ft-design-system",
    protected: false,
  },
  {
    name: "AfterCrop",
    tagline: "Designed for the warehouse floor, not the office, where speed and clarity actually matter",
    href: "/work/aftercrop",
    protected: false,
  },
];

const builtWithAI = [
  {
    name: "CouponTracker",
    tagline: "Turning scattered screenshots into a system people can actually use and trust",
    href: "/work/coupontracker",
  },
  {
    name: "Design QA",
    tagline: "An LLM-free quality gate that catches design-to-code drift before release",
    href: "/work/designqa",
  },
  {
    name: "Component-first Design",
    tagline: "Moving from static screens to systems that behave closer to real products",
    href: "/work/component-first-design",
  },
];
---

<BaseLayout>
  <div data-view-panel="human">
    <Navigation minimal />
  </div>

  <main id="main">
    <div data-view-panel="machine" hidden class="bg-bg-deep min-h-screen">
      <MachinePageShell
        title="Chetan Kummari"
        pageHref="/"
        pageLabel="portfolio page"
        text={homeMachineText}
      />
    </div>

    <div data-view-panel="human">
      <div class="minimal-page">
        <!-- Greeting -->
        <section class="section-reveal">
          <p class="intro-line">
            Hey, I'm Chetan.
          </p>

          <hr class="editorial-rule" />

          <!-- Bio with drop cap -->
          <p class="drop-cap">
            I'm a product designer with six years of experience building across industries. I love to build things and learn from the making of them, and lately I've been exploring what AI means for the craft of design. Currently I design at Generalmind, where I build AI-assisted enterprise workflows and operational systems for autonomous task execution. Before that I designed logistics systems at Freight Tiger, and earlier worked with Konic Technologies, Versatile Mobitech, and others.
          </p>

          <p>
            I help teams build systems that scale, bring clarity to complex operations, and make enterprise software feel human. My work lives in AI-native enterprise workflows, B2B platforms, design systems, and operational tools, places where the challenge is less about visual polish and more about clarity under complexity. Those experiences shaped me to be more <em>systematic</em>, <em>collaborative</em>, and <em>empathetic</em>. Here are some projects that reflect that journey:
          </p>
        </section>

        <!-- Design work -->
        <section class="section-gap section-reveal">
          {designWork.map((link) => (
            <a
              href={link.href}
              class="project-link"
            >
              <span class="project-name">{link.name}.</span> {link.tagline}{CASE_STUDY_PASSWORD_LOCK_ENABLED && link.protected ? "\u00a0↗" : ""}
            </a>
          ))}
        </section>

        <!-- Built with AI -->
        <section class="section-reveal" style="margin-top: 3rem;">
          <p class="min-small" style="font-style: italic; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem;">Built with AI</p>
          <p style="margin-bottom: 1.5rem;">
            The strongest AI work here is not screen generation. It is design workflow infrastructure: tools that automate QA, protect design-system fidelity, and help teams move from manual execution to higher-quality orchestration.
          </p>

          {builtWithAI.map((link) => (
            <a
              href={link.href}
              class="project-link"
            >
              <span class="project-name">{link.name}.</span> {link.tagline}
            </a>
          ))}
        </section>

        <!-- More work -->
        <section class="section-reveal" style="margin-top: 1.5rem;">
          <a
            href="/work"
            class="project-link"
            style="color: var(--color-text-tertiary);"
          >
            <span class="project-name">More work.</span> A collection of smaller systems, experiments, and ideas that shipped
          </a>
        </section>

        <!-- Closing -->
        <section class="closing-section section-reveal">
          <p>
            Good design begins with curiosity. Outside of work, I write about <a href={article.url} target="_blank" rel="noopener noreferrer">complex table design</a>, build side projects on <a href="https://github.com/chetank2" target="_blank" rel="noopener noreferrer">GitHub</a>, and share my work on <a href="https://x.com/kchetank19" target="_blank" rel="noopener noreferrer">X</a> and <a href="https://linkedin.com/in/chetan-kumar25/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
          <p style="margin-top: 2rem;">
            <a href="mailto:mymailchetan25@gmail.com">mymailchetan25@gmail.com</a>
          </p>
        </section>
      </div>
    </div>
  </main>

  <ViewModeToggle />
  <div data-view-panel="human">
    <Footer minimal />
  </div>
</BaseLayout>
